#!/usr/bin/env bash
# Audyt bezpieczeństwa (tylko odczyty): keyloggery, podsłuch, obce logowania, backdoory.
# Użycie: ./sec-audit.sh
# Uruchom we własnym terminalu - sudo zapyta o hasło tam.

R=$'\e[31m'; Y=$'\e[33m'; G=$'\e[32m'; B=$'\e[1m'; N=$'\e[0m'
WARNS=0
warn() { echo "${R}[!] $*${N}"; WARNS=$((WARNS+1)); }
ok()   { echo "${G}[ok]${N} $*"; }
info() { echo "    $*"; }
hdr()  { echo; echo "${B}== $* ==${N}"; }

# Porty, których obecności na wszystkich interfejsach się spodziewamy (edytuj pod siebie)
KNOWN_PORTS=" 111 902 6566 5353 "
# Procesy, które legalnie czytają /dev/input
KNOWN_INPUT="acpid|Xorg|Xwayland|gnome-shell|gnome-session|systemd-logind|systemd|mutter|libinput|upowerd|pipewire|wireplumber|gsd-|scim"

[ "$EUID" -eq 0 ] && echo "${Y}Uwaga: uruchomiony jako root - testy ~ (autostart, .bashrc, authorized_keys) dotyczą katalogu roota. Uruchom bez sudo.${N}"
SUDO=""
if sudo -v 2>/dev/null; then SUDO="sudo"; else echo "${Y}Brak sudo - część testów będzie ograniczona.${N}"; fi

hdr "1. Logowania"
who
REMOTE=$(last -w -n 50 2>/dev/null | grep -vE "^(reboot|wtmp|$)" | awk '$2 !~ /^(:[0-9]+|tty[0-9]+|pts\/[0-9]+)$/ || $3 ~ /^[0-9]+\.[0-9]+\./ {print}' | grep -E "[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+" )
[ -n "$REMOTE" ] && { warn "Logowania z adresów IP (zdalne):"; echo "$REMOTE"; } || ok "brak zdalnych logowań w ostatnich wpisach"
if [ -n "$SUDO" ]; then
  FAILED=$($SUDO lastb -n 20 2>/dev/null | grep -vE "^$|btmp (begins|zaczyna)")
  [ -n "$FAILED" ] && { warn "Nieudane próby logowania:"; echo "$FAILED"; } || ok "brak nieudanych logowań (btmp)"
fi

hdr "2. Porty nasłuchujące"
while read -r proto st rq sq local peer proc; do
  addr=${local%:*}; port=${local##*:}
  case "$addr" in 127.*|"[::1]"|::1) continue;; esac
  if [[ "$KNOWN_PORTS" == *" $port "* || "$proc" == *avahi-daemon* ]]; then info "$proto $local  $proc (znany)"
  else warn "NOWY port dostępny z sieci: $proto $local  ${proc:-<nieznany proces>}"; fi
done < <($SUDO ss -tulnp 2>/dev/null | awk 'NR>1')

hdr "3. Połączenia wychodzące (inne niż 80/443/53, poza LAN)"
ODD=$($SUDO ss -tnp state established 2>/dev/null | awk 'NR>1{print $4" -> "$3" "$5}' | awk '{split($3,a,":"); p=a[length(a)]; split($3,b,"."); if (p!=80 && p!=443 && p!=53 && $3 !~ /^(127\.|192\.168\.|10\.|\[::1\])/) print}')
[ -n "$ODD" ] && { warn "Nietypowe połączenia:"; echo "$ODD"; } || ok "tylko 80/443/53 lub LAN"

hdr "4. Procesy z /tmp, /dev/shm lub usuniętego pliku"
BADEXE=$($SUDO sh -c 'ls -l /proc/[0-9]*/exe 2>/dev/null' | grep -E "\(deleted\)|/tmp/|/dev/shm/|/var/tmp/")
[ -n "$BADEXE" ] && { warn "Podejrzane binaria:"; echo "$BADEXE"; } || ok "brak"

hdr "5. Znane narzędzia szpiegujące (po nazwie procesu)"
SPY=$(ps -eo user,pid,comm | grep -iE " (logkeys|lkl|keylogger|pykeylogger|uberkeylogger|xspy|xkeylog|xinput|xev|xdotool|x11vnc|Xvnc|vncserver|tigervncserver|teamviewerd|anydesk|rustdesk|remoting_host|ngrok|socat|ncat|nc|netcat|weston-screenshooter|scrot|import|ffmpeg|obs)$")
[ -n "$SPY" ] && { warn "Znaleziono (sprawdź, czy to Ty to uruchomiłeś):"; echo "$SPY"; } || ok "brak"

hdr "6. Kto ma otwarte /dev/input/* (podsłuch klawiatury)"
if [ -n "$SUDO" ]; then
  HOLD=$($SUDO sh -c 'for f in /dev/input/event* /dev/input/mice; do fuser -v "$f" 2>&1; done' | grep -vE "^\s*$|USER|UŻYTKOWNIK" | awk '{print $NF}' | sort -u)
  UNK=$(echo "$HOLD" | grep -vE "$KNOWN_INPUT")
  info "czytają: $(echo $HOLD)"
  [ -n "$UNK" ] && { warn "Nietypowi czytelnicy /dev/input:"; echo "$UNK"; } || ok "tylko znane komponenty (X/systemd)"
fi
if getent group input | grep -q "mkrej"; then warn "mkrej jest w grupie 'input' - może czytać klawiaturę bez roota"; else ok "mkrej nie jest w grupie input"; fi

hdr "7. Autostart, cron, usługi"
ls -A ~/.config/autostart 2>/dev/null | sed 's/^/    autostart: /'
ls -A ~/.config/systemd/user 2>/dev/null | sed 's/^/    user-unit: /'
crontab -l 2>/dev/null | grep -v '^#' | sed 's/^/    crontab: /'
$SUDO ls -A /var/spool/cron/crontabs 2>/dev/null | sed 's/^/    spool: /'
NONPKG=$(for f in /etc/systemd/system/*.service; do [ -f "$f" ] && [ ! -L "$f" ] && ! dpkg -S "$f" >/dev/null 2>&1 && echo "$f"; done)
[ -n "$NONPKG" ] && { warn "Własne usługi systemd (nie z pakietów) - zweryfikuj:"; echo "$NONPKG"; } || ok "brak własnych usług"
RECENT=$(find /etc/cron* /etc/systemd/system /etc/profile.d ~/.config/autostart -mtime -14 -type f 2>/dev/null)
[ -n "$RECENT" ] && { warn "Zmienione w ciągu 14 dni:"; echo "$RECENT"; }

hdr "8. Backdoory / hooki"
[ -s ~/.ssh/authorized_keys ] && { warn "Są klucze w authorized_keys:"; cut -c1-90 ~/.ssh/authorized_keys; } || ok "brak authorized_keys"
[ -e /etc/ld.so.preload ] && warn "Istnieje /etc/ld.so.preload: $(cat /etc/ld.so.preload)" || ok "brak ld.so.preload"
[ -n "${LD_PRELOAD:-}" ] && warn "LD_PRELOAD=$LD_PRELOAD" || ok "LD_PRELOAD pusty"
RC=$(grep -nE "curl|wget|nc |ncat|base64 -d|python.* -c|/tmp/|/dev/tcp|xinput|script " ~/.bashrc ~/.profile ~/.bash_profile ~/.bash_login ~/.xprofile ~/.xinitrc ~/.xsessionrc 2>/dev/null)
[ -n "$RC" ] && { warn "Podejrzane linie w plikach startowych:"; echo "$RC"; } || ok "pliki startowe czyste"
if [ -n "$SUDO" ]; then
  PL=$($SUDO sh -c 'for e in /proc/[0-9]*/environ; do v=$(tr "\0" "\n" <"$e" 2>/dev/null | grep "^LD_PRELOAD="); [ -n "$v" ] && echo "$(basename $(dirname $e)) $(cat $(dirname $e)/comm 2>/dev/null) $v"; done' | grep -vE "libmozsandbox\.so$|libgtk3-nocsd|vmware")
  [ -n "$PL" ] && { warn "Procesy z nietypowym LD_PRELOAD:"; echo "$PL"; } || ok "brak nietypowych LD_PRELOAD (pomijam Firefox/VMware)"
fi

hdr "9. Konta i uprawnienia"
EXTRA0=$(awk -F: '$3==0 && $1!="root"{print $1}' /etc/passwd)
[ -n "$EXTRA0" ] && warn "Dodatkowe konta UID 0: $EXTRA0" || ok "tylko root ma UID 0"
SHELLS=$(awk -F: '$7 !~ /(nologin|false|sync|shutdown|halt)$/ {print $1":"$7}' /etc/passwd)
info "konta z powłoką: $(echo $SHELLS)"
$SUDO sh -c 'grep -rvE "^#|^$" /etc/sudoers.d 2>/dev/null' | grep -iE "NOPASSWD" && warn "NOPASSWD w sudoers.d" || ok "brak NOPASSWD w sudoers.d"
$SUDO awk -F: '($2=="" ){print $1}' /etc/shadow 2>/dev/null | grep . && warn "Konta z PUSTYM hasłem (wyżej)"

hdr "10. Jądro"
T=$(cat /proc/sys/kernel/tainted)
[ "$T" = "0" ] && ok "jądro nie jest 'tainted'" || info "tainted=$T (sterowniki nvidia/vmware zwykle to powodują; 'dmesg | grep -i taint' dla szczegółów)"

hdr "11. Zdalny dostęp (zainstalowane pakiety)"
RA=$(dpkg -l 2>/dev/null | grep -iE "chrome-remote-desktop|teamviewer|anydesk|x11vnc|tigervnc|rustdesk|openssh-server|xrdp|logkeys" | awk '{print $2, $3}')
[ -n "$RA" ] && { warn "Pakiety zdalnego dostępu (usuń, jeśli nieużywane):"; echo "$RA"; } || ok "brak"

hdr "12. Integralność pakietów (debsums)"
if ! command -v debsums >/dev/null; then
  warn "Brak debsums - nie sprawdzę integralności plików. Zainstaluj: sudo apt install debsums"
elif [ -z "$SUDO" ]; then info "debsums wymaga sudo - pominięto"
else
  CH=$($SUDO debsums -c 2>/dev/null | head -30)
  [ -n "$CH" ] && { warn "Zmodyfikowane pliki pakietów (zmiany w /etc bywają normalne):"; echo "$CH"; } || ok "sumy zgodne z pakietami"
fi

hdr "13. rkhunter"
if ! command -v rkhunter >/dev/null; then
  warn "Brak rkhunter - nie sprawdzę rootkitów. Zainstaluj: sudo apt install rkhunter, potem: sudo rkhunter --update && sudo rkhunter --propupd"
elif [ -z "$SUDO" ]; then info "rkhunter wymaga sudo - pominięto"
else
  info "(pierwsze użycie: sudo rkhunter --update; sudo rkhunter --propupd; po większych aktualizacjach systemu powtórz --propupd)"
  RK=$($SUDO rkhunter --check --sk --rwo 2>/dev/null)
  [ -n "$RK" ] && { warn "rkhunter zgłasza (po aktualizacjach systemu to często fałszywy alarm):"; echo "$RK"; } || ok "rkhunter nic nie zgłasza"
fi

hdr "14. ClamAV"
if ! command -v clamscan >/dev/null; then
  warn "Brak clamscan (sudo apt install clamav)"
else
  DB=/var/lib/clamav/daily.cvd; [ -f /var/lib/clamav/daily.cld ] && DB=/var/lib/clamav/daily.cld
  AGE=$(( ( $(date +%s) - $(stat -c %Y "$DB" 2>/dev/null || echo 0) ) / 86400 ))
  if [ "$AGE" -gt 7 ]; then
    warn "Baza ClamAV ma $AGE dni - próbuję zaktualizować (freshclam)"
    [ -n "$SUDO" ] && $SUDO freshclam --quiet 2>&1 | sed 's/^/    /' || info "bez sudo nie zaktualizuję: sudo freshclam"
  fi
  # Wybrane miejsca (jak w szybkim skanie), pomijane duże/bezpieczne katalogi - tylko istniejące
  CL_TARGETS=(); for d in "$HOME" /tmp /var/tmp /usr/local/bin /usr/bin /etc/cron.d /etc/cron.daily; do [ -d "$d" ] && CL_TARGETS+=("$d"); done
  CL_EXCL=(); for d in .cache .mozilla .local/share/Trash .wine .p2 .gradle .m2 .npm snap; do CL_EXCL+=(--exclude-dir="^$HOME/$d$"); done
  info "Skanuję: ${CL_TARGETS[*]} (pliki do 30 MB; może potrwać kilka minut)..."
  CL=$(clamscan -r "${CL_TARGETS[@]}" "${CL_EXCL[@]}" --max-filesize=30M --max-scansize=30M 2>&1)
  echo "$CL" | grep -E "FOUND|Infected files|Scanned files|^Time" | sed 's/^/    /'
  echo "$CL" | grep -q "FOUND" && warn "ClamAV znalazł zagrożenia (linie FOUND wyżej)" || ok "ClamAV: nic nie znaleziono"
fi


echo; echo "${B}Podsumowanie:${N} ostrzeżeń: $WARNS"
[ "$WARNS" -eq 0 ] && echo "${G}Nic podejrzanego.${N}" || echo "${Y}Przejrzyj linie [!]. Wiele to fałszywe alarmy - sprawdź każdą osobno.${N}"
